# Optional third-party integrations (copy to .env and fill in)
# AES-256-GCM hex key; auto-generated to data dir if omitted
HOLDINGS_SECRET_KEY=
MORALIS_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
HOLDINGS_CRYPTO_CHAINS=eth,polygon,bsc,arbitrum,optimism,base,avalanche

# Auth (email/password + sessions)
AUTH_PUBLIC_URL=http://127.0.0.1:3847
WEB_PUBLIC_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
# local | hub | client
DEPLOYMENT_MODE=local
# Client mode: official hub for marketplace (no trailing slash)
CLOUD_HUB_URL=
AUTH_SESSION_SECRET=change-me-in-production
AUTH_ALLOW_ANONYMOUS=false
# Set AUTH_ALLOW_ANONYMOUS=true only for headless local tooling — never on a network-exposed host.
AUTH_ALLOW_SIGNUP=true
AUTH_INVITE_CODES=
# Optional password for INITIAL_ADMINS seed users (local/client only)
INITIAL_ADMIN_PASSWORD=
# Pre-seeded platform admins (Name:email, comma-separated; emails must match signup/login).
# Leave empty for OSS: the first signup becomes platform admin automatically.
INITIAL_ADMINS=
AUTH_SESSION_TTL_DAYS=30
FEDERATION_TOKEN=
FEDERATION_PUBLIC_URL=http://127.0.0.1:3847

# Transactional email (Resend preferred for SaaS; SMTP fallback)
# EMAIL_PROVIDER=resend
# EMAIL_FROM=GodMode <noreply@example.com>
# RESEND_API_KEY=
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Public marketing site URL (Stripe business website)
# BUSINESS_WEBSITE_URL=https://www.example.com

# Optional OAuth (Google). GitHub sign-in prefers GITHUB_APP_* below.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Deprecated classic GitHub OAuth (unused when GITHUB_APP_CLIENT_* is set):
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_INTEGRATION_CLIENT_ID=
# OAUTH_GITHUB_INTEGRATION_CLIENT_SECRET=

# Preferred: one GitHub App for sign-in + Connect + Projects webhooks + Core Support issues.
# Callbacks: {AUTH_PUBLIC_URL}/api/auth/oauth/github/callback
#            {AUTH_PUBLIC_URL}/api/integrations/github/callback
# Webhook:   {AUTH_PUBLIC_URL}/api/integrations/github/webhook
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=godmode-cloud
# GITHUB_APP_PLATFORM_ACCOUNT_LOGIN=ReBoticsAI
# GITHUB_APP_PLATFORM_INSTALLATION_ID=

# Tasks <-> GitHub Projects poll (default 60000 ms = 1 min; clamped 1-30 min).
# Near-real-time path for user-owned boards. Org-owned boards also get projects_v2_item webhooks.
# GITHUB_PROJECTS_SYNC_POLL_MS=60000
# GITHUB_PROJECTS_SYNC_POLL_ENABLED=0

# Backups (Hostinger cron + optional S3-compatible offsite)
# BACKUP_LOCAL_DIR=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=godmode/

# SaaS coding (#178): on SaaS, unset defaults ON (opt-out with =false). Keep local plugins off.
# PLATFORM_SAAS_ALLOW_CODE_ACCESS=false
# PLATFORM_SAAS_ALLOW_LOCAL_PLUGINS=false
# Hub/client Linux: CODING_TERMINAL_SANDBOX=required (default). Set off only for emergency debug.
# CODING_TERMINAL_SANDBOX=required
# cursor_cloud SDK sandbox for built-in Shell/FS (#171). Hub/client Linux: required (default).
# CURSOR_SDK_SANDBOX=required
# CURSOR_SDK_SANDBOX=off
# Terminal sandbox network: none (default, SaaS-safe), allowlist (kernel netns + UDS CONNECT allowlist; prefer over shared), or shared (full host egress; FS jail still on)
# CODING_TERMINAL_NET=none
# Optional npm-from-terminal: CODING_TERMINAL_NET=allowlist
# CODING_TERMINAL_EGRESS_HOSTS=registry.npmjs.org,github.com,api.github.com
# (empty EGRESS_HOSTS with allowlist uses built-in npm/GitHub defaults)

# Layer 4 ephemeral builds (#164 / #167 / #178): host build supervisor (docker.sock stays off Bridge).
# SaaS staging/prod: set ephemeral + allowlist (demo needs registry) and a per-data-root supervisor token.
# CODING_BUILD_MODE=off
# CODING_BUILD_MODE=ephemeral
# CODING_BUILD_SUPERVISOR_URL=http://host.docker.internal:8792
# CODING_BUILD_SUPERVISOR_TOKEN=
# Build container network: none (default) or allowlist (Docker --internal net + CONNECT proxy)
# CODING_BUILD_NET=none
# CODING_BUILD_NET=allowlist
# Optional host override (falls back to CODING_TERMINAL_EGRESS_HOSTS, then npm/GitHub defaults):
# CODING_BUILD_EGRESS_HOSTS=registry.npmjs.org,github.com,api.github.com
# CODING_BUILD_EGRESS_NETWORK=godmode-build-egress

# Coding quotas (#96 Slice 1): hub/SaaS defaults; 0 = unlimited on local dev
# CODING_TERMINAL_GLOBAL_CONCURRENCY=4
# CODING_TERMINAL_TENANT_CONCURRENCY=2
# CODING_PTY_MAX_PER_TENANT=3
# CODING_BUILD_GLOBAL_CONCURRENCY=2
# CODING_BUILD_TENANT_CONCURRENCY=1
# Runtime kill switches: POST /api/admin/authority/coding-kills/...

# Signed releases and host-supervised updates
UPDATE_CHANNEL=stable
# UPDATE_MANIFEST_URL=  # defaults to the official stable/nightly GitHub release channel
UPDATE_READINESS_TOKEN=replace-for-supported-release-installs
# INSTALLATION_SURFACE=developer_source
# Desktop Electron installs set INSTALLATION_SURFACE=electron automatically.
# UPDATE_SUPERVISOR_URL=http://127.0.0.1:8799/
# UPDATE_SUPERVISOR_TOKEN=
# UPDATE_SNAPSHOT_DIR=

# Stripe marketplace credits (hub SaaS mode only; not used in local OSS)
# STRIPE_SECRET_KEY=
# STRIPE_CREDITS_PER_USD=100

# Platform paths (optional overrides)
PLATFORM_DATA_DIR=
PLATFORM_REPO_ROOT=

# Bridge
BRIDGE_PORT=3847
BRIDGE_HOST=127.0.0.1

# Optional domain plugins (semicolon-separated on Windows). See docs/PLUGIN_AUTHORING.md.
# GODMODE_PLUGIN_PATH=

# Private GitHub plugin repos (Marketplace installType: plugin with pluginRepo HTTPS URL)
# GITHUB_TOKEN=

# Dev-only: allow any browser Origin when not in production (default: WEB_ORIGIN only)
# CORS_PERMISSIVE=true

# Optional: Cursor subscription / contractor (User API key from cursor.com/dashboard)
# CURSOR_API_KEY=

# Exa web_search / fetch_url: tenant BYOK via Vault secret name "exa_api_key"
# (or agent provider "exa"). Do not set a shared platform EXA_API_KEY on SaaS.

# Embeddings (semantic memory + wiki RAG). Hub: attach to host EmbeddingGemma on :8082.
# EMBEDDINGS_ENABLED=true
# EMBEDDINGS_EXTERNAL=true
# EMBEDDINGS_SERVER_HOST=host.docker.internal
# EMBEDDINGS_PORT=8082
# EMBEDDINGS_MODEL_PATH=
