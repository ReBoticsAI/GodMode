# SaaS staging beside an existing private hub (e.g. Z440 family hub).
# Copy to deploy/.env.saas-staging — never commit the real file.

GODMODE_IMAGE=ghcr.io/reboticsai/godmode@sha256:REPLACE_WITH_RELEASE_DIGEST

# Host port must not collide with the private hub (often 8080).
SAAS_HOST_PORT=9080
# Optional bind mount (Z440 example). Omit to use the compose named volume.
# SAAS_DATA_DIR=/mnt/storage/godmode-saas-data

DEPLOYMENT_MODE=hub
INSTALLATION_SURFACE=saas

# Public URLs as browsers reach this staging instance
WEB_PUBLIC_URL=http://127.0.0.1:9080
AUTH_PUBLIC_URL=http://127.0.0.1:9080
WEB_ORIGIN=http://127.0.0.1:9080

AUTH_SESSION_SECRET=replace-with-32-plus-random-bytes
AUTH_ALLOW_ANONYMOUS=false
AUTH_ALLOW_SIGNUP=false
AUTH_INVITE_CODES=

# Seed your operator admin (not paywalled)
INITIAL_ADMINS=Admin:you@example.com
# INITIAL_ADMIN_PASSWORD=only-for-bootstrap-then-change

# Stripe — Product "GodMode Cloud" with recurring Prices:
STRIPE_SECRET_KEY=sk_test_...
STRIPE_SAAS_CHECKOUT_MODE=subscription
STRIPE_SAAS_PRICE_MONTHLY=price_...
STRIPE_SAAS_PRICE_YEARLY=price_...
# GodMode Seller seat (~$4.99/mo) — Sell commerce only (#677 / #679):
# STRIPE_SAAS_PRICE_SELLER_MONTHLY=price_...
# Legacy single-price fallback (optional if monthly/yearly are set):
# STRIPE_SAAS_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Forward webhooks while testing:
#   stripe listen --forward-to http://127.0.0.1:9080/api/saas/stripe/webhook

BRIDGE_PORT=3847
BRIDGE_HOST=127.0.0.1
PLATFORM_DATA_DIR=/data
UPDATE_CHANNEL=stable

# Shared host embedder + fair queue (#69 C). Point at host llama-server --embeddings.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_EXTERNAL=true
EMBEDDINGS_SERVER_HOST=host.docker.internal
EMBEDDINGS_PORT=8082
EMBEDDINGS_QUEUE_ENABLED=true
# EMBEDDINGS_QUEUE_RPS=8

# SaaS coding (#178): unset defaults ON (opt-out with =false). Keep local plugins off.
# PLATFORM_SAAS_ALLOW_CODE_ACCESS=false
PLATFORM_SAAS_ALLOW_LOCAL_PLUGINS=false

# Layer 3 terminal: hub/client default CODING_TERMINAL_SANDBOX=required.
# allowlist: UDS CONNECT proxy for GitHub / npm (required for Cloud git_clone, #442).
# CODING_TERMINAL_NET=none locks interactive terminals to no egress.
CODING_TERMINAL_NET=allowlist

# Layer 4: run deploy/build-supervisor against THIS SaaS data dir (not family hub).
# Share CODING_BUILD_SUPERVISOR_TOKEN only with that supervisor instance.
CODING_BUILD_MODE=ephemeral
CODING_BUILD_SUPERVISOR_URL=http://host.docker.internal:8792
CODING_BUILD_SUPERVISOR_TOKEN=replace-with-saas-build-supervisor-token
CODING_BUILD_NET=allowlist
# CODING_BUILD_EGRESS_HOSTS=registry.npmjs.org,github.com,api.github.com

# Coding quotas (#96 Slice 1): hub/SaaS defaults; 0 = unlimited
CODING_TERMINAL_GLOBAL_CONCURRENCY=4
CODING_TERMINAL_TENANT_CONCURRENCY=2
CODING_PTY_MAX_PER_TENANT=3
CODING_BUILD_GLOBAL_CONCURRENCY=2
CODING_BUILD_TENANT_CONCURRENCY=1
