# GodMode hub (production SaaS) — copy to deploy/.env.production
# Never commit the real file.

GODMODE_IMAGE=ghcr.io/OWNER/godmode@sha256:REPLACE_WITH_RELEASE_DIGEST
DEPLOYMENT_MODE=hub
INSTALLATION_SURFACE=saas
UPDATE_CHANNEL=stable
UPDATE_READINESS_TOKEN=replace-with-separate-random-supervisor-token
# Optional one-click apply through a dedicated host supervisor:
# UPDATE_SUPERVISOR_URL=http://host.docker.internal:8799/
# UPDATE_SUPERVISOR_TOKEN=replace-with-separate-random-supervisor-token

# Public URLs (no trailing slash). Prod nginx serves SPA + /api on one origin —
# use the same hostname for all three (cookies / CSRF / Secure flag).
WEB_PUBLIC_URL=https://app.example.com
AUTH_PUBLIC_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com

# Required
AUTH_SESSION_SECRET=replace-with-32-plus-random-bytes
AUTH_ALLOW_ANONYMOUS=false
AUTH_ALLOW_SIGNUP=false
AUTH_INVITE_CODES=

# Pre-seed platform admins: Name:email,Name:email
INITIAL_ADMINS=Admin:admin@example.com

# SaaS paywall (INSTALLATION_SURFACE=saas only — ignored on private_hub)
# Create Product "GodMode Cloud" with USD monthly ($9.99) + yearly ($74.99) Prices, then:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SAAS_CHECKOUT_MODE=subscription
# STRIPE_SAAS_PRICE_MONTHLY=price_...
# STRIPE_SAAS_PRICE_YEARLY=price_...
# Sandbox (ReBotics test): monthly price_1TuEaJPAFoYyWIoUk9MI17ae / yearly price_1TuEaQPAFoYyWIoUNPvHfTXs
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://app.example.com/api/saas/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed

# Optional Stripe marketplace credits — also configurable via Admin → Billing
# STRIPE_CREDITS_PER_USD=100

# Federation (optional — for cross-bridge sharing)
FEDERATION_TOKEN=
FEDERATION_PUBLIC_URL=https://app.example.com

BRIDGE_PORT=3847
BRIDGE_HOST=127.0.0.1
PLATFORM_DATA_DIR=/data

# Public marketing site (apps/web /www; Cloudflare Pages or same origin) — required before live Stripe
BUSINESS_WEBSITE_URL=https://www.example.com

# Transactional email (do not use Hostinger shared mailbox)
# Paste a real Resend API key (re_ + long secret). The literal re_... placeholder will not send mail.
EMAIL_PROVIDER=resend
EMAIL_FROM=GodMode <noreply@example.com>
RESEND_API_KEY=re_...
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Optional Google OAuth. GitHub prefers GITHUB_APP_* (classic OAUTH_GITHUB_* deprecated).
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Preferred GitHub App (sign-in + Connect + webhooks + Core Support issues)
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/godmode-secrets/github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=godmode-cloud
# GITHUB_APP_PLATFORM_ACCOUNT_LOGIN=ReBoticsAI
# GITHUB_APP_PLATFORM_INSTALLATION_ID=

# Offsite backups (optional; local snapshots under PLATFORM_DATA_DIR are first-party).
# On Hostinger Docker prod, cron uses deploy/scripts/run-platform-backup.sh (not bare node).
# That runner briefly stops Bridge so the one-shot container can ATTACH DuckDB;
# prefer Admin "Run local snapshot" for zero-downtime in-process COPY.
# GODMODE_BACKUP_SKIP_STOP=1
# BACKUP_LOCAL_DIR=/data/backups
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=godmode-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=godmode/

# SaaS coding (#178): unset defaults ON. Set false to opt out. Keep local plugins off.
# PLATFORM_SAAS_ALLOW_CODE_ACCESS=false
PLATFORM_SAAS_ALLOW_LOCAL_PLUGINS=false

# Layer 4: sibling host build supervisor (deploy/build-supervisor/). Prefer a token
# bound to this SaaS PLATFORM_DATA_DIR (do not share with a private_hub data root).
# Hostinger checklist: deploy/hostinger.md §11. Start with:
#   deploy/scripts/start-build-supervisor.sh
#   deploy/scripts/lock-build-supervisor-wan.sh
# CODING_BUILD_MODE=ephemeral
# CODING_BUILD_SUPERVISOR_URL=http://host.docker.internal:8792
# CODING_BUILD_SUPERVISOR_TOKEN=
# CODING_BUILD_NET=allowlist
# CODING_BUILD_EGRESS_HOSTS=registry.npmjs.org,github.com,api.github.com

# Exa web tools (#218): tenant BYOK only. Tenants paste keys in Vault as
# "exa_api_key" (or agent provider "exa"). Do not add a shared EXA_API_KEY here.
