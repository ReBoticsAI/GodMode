# Cloudflare Pages auto-runs `npm clean-install` before the build command.
# Skip lifecycle scripts so native addons (node-pty, better-sqlite3, duckdb) do not fail
# the marketing web build. GitHub Actions overrides with NPM_CONFIG_IGNORE_SCRIPTS=false.
#
# Local Bridge/desktop after plain `npm install` / `npm ci`:
#   npm run rebuild:natives
# or let `npm run dev` / `npm run dev:bridge` call scripts/ensure-native-addons.mjs
# (rebuilds only when addons fail to load). Prefer a full install with scripts:
#   NPM_CONFIG_IGNORE_SCRIPTS=false npm ci
# Always rebuild from the repo root; do not npm install/rebuild under apps/bridge
# (that creates a nested node_modules copy without fixing the hoisted package).
ignore-scripts=true
