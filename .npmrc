# Cloudflare Pages auto-runs `npm clean-install` before the build command.
# Skip lifecycle scripts so native addons (node-pty, better-sqlite3) do not fail
# the marketing web build. GitHub Actions overrides with NPM_CONFIG_IGNORE_SCRIPTS=false.
# Local bridge/desktop: NPM_CONFIG_IGNORE_SCRIPTS=false npm ci  (or npm rebuild …).
ignore-scripts=true
